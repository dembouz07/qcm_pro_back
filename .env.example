APP_NAME="QCM App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dakar
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qcm_app
DB_USERNAME=postgres
DB_PASSWORD=passer

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# ─── PayTech (abonnement formateur 1000 FCFA/mois) ───
# À définir sur Laravel Cloud (onglet Environment). Ne jamais commiter les vraies valeurs.
# Clés récupérées sur le dashboard PayTech : Paramètres > API
PAYTECH_ENV=test
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
SUBSCRIPTION_AMOUNT=1000
SUBSCRIPTION_TRIAL_DAYS=30
FRONTEND_URL=https://qcm-nine.vercel.app
