APP_NAME="Check Performance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dakar
FRONTEND_URL=http://localhost:5173
COMMERCIAL_LAUNCH_ENABLED=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qcm_app
DB_USERNAME=postgres
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_TOKEN_EXPIRATION=10080
ANALYTICS_HASH_KEY=
ANALYTICS_INTERNAL_EMAILS=
ANALYTICS_METRIC_ENVIRONMENT=local
ANALYTICS_TEST_STARTED_AT=
SUPER_ADMIN_EMAILS=
TRUSTED_PROXIES=
# Réservé aux données de démonstration locales ; 12 caractères minimum.
DEMO_SEED_PASSWORD=
SESSION_DOMAIN=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=check-performance-session

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="support@checkperformance.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── PayTech ───
# À définir sur Laravel Cloud (onglet Environment). Ne jamais commiter les vraies valeurs.
# Clés récupérées sur le dashboard PayTech : Paramètres > API
PAYTECH_ENV=test
PAYTECH_API_KEY=
PAYTECH_API_SECRET=

# Production : les deux services doivent partager le même domaine principal.
# APP_URL=https://api.checkperformance.sn
# FRONTEND_URL=https://app.checkperformance.sn
# SANCTUM_STATEFUL_DOMAINS=app.checkperformance.sn
# SESSION_DOMAIN=.checkperformance.sn
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# MAIL_MAILER=smtp
# MAIL_HOST=<fournisseur transactionnel>
# MAIL_PORT=587
# MAIL_USERNAME=<secret plateforme>
# MAIL_PASSWORD=<secret plateforme>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=support@checkperformance.sn
